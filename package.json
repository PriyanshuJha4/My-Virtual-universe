{
  "name": "personal-virtual-universe",
  "productName": "Personal Virtual Universe",
  "version": "0.2.0",
  "private": true,
  "description": "A simple, local-first desktop app for organizing characters and their files.",
  "author": "Personal Virtual Universe",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p electron/tsconfig.json --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis",
    "build:electron": "tsc -p electron/tsconfig.json",
    "test:smoke": "node scripts/smoke-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.personalvirtualuniverse.desktop",
    "productName": "Personal Virtual Universe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
